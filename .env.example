# Zugangsdaten des Supabase-Projekts (Region Frankfurt).
# Zu finden im Dashboard unter: Project Settings -> API Keys
#
# Beide Werte sind oeffentlich und landen im Browser – das ist so vorgesehen.
# Der Schutz der Daten kommt aus den Row-Level-Security-Regeln der Datenbank,
# nicht aus der Geheimhaltung dieser Schluessel.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Der "Publishable key" (beginnt mit sb_publishable_). Frueher hiess er "anon".
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NIEMALS den "Secret key" (sb_secret_...) hier eintragen – frueher
# "service_role". Der umgeht alle Sicherheitsregeln und darf eine Web-App
# nie erreichen.
