# Zugangsdaten des Supabase-Projekts (Region Frankfurt).
# Beide Werte sind oeffentlich und landen im Browser – das ist so vorgesehen.
# Der Schutz der Daten kommt aus den Row-Level-Security-Regeln der Datenbank,
# nicht aus der Geheimhaltung dieser Schluessel.
#
# Zu finden im Supabase-Dashboard unter: Project Settings -> API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# NIEMALS den service_role-Key hier eintragen. Der umgeht alle
# Sicherheitsregeln und darf eine Web-App nie erreichen.
